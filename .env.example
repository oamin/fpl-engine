# Optional. Free key: https://the-odds-api.com/
# Enables multi-book match odds + per-event player props.
# EPL season outrights are collected when the API lists matching has_outrights sports.
# Prefer exporting ODDS_API_KEY in the shell if you do not want a local .env.
#
# QUOTA: free tier ~500 credits. Prefer --from-snapshot / --espn-only.
# Cost ≈ markets × regions × events. Soccer props: regions=us only.
# See CONTEXT.md "Odds API quota procedure" and .cursor/rules/odds-api-quota.mdc.
ODDS_API_KEY=
ODDS_API_REGION=uk
# Regions for per-event props (soccer player props are mainly US books).
# player_props.py defaults to us if unset. Use us,us2 only if you have quota.
ODDS_API_PROP_REGIONS=us

# Betfair Exchange (delayed app key is enough for price reads).
# Never commit real values. Session needs username+password OR a session token.
BETFAIR_APP_KEY=
BETFAIR_USERNAME=
BETFAIR_PASSWORD=
BETFAIR_SESSION_TOKEN=
